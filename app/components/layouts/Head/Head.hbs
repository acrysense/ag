{{#each baseMeta}}
    <meta {{{attrs this}}} />
{{/each}}

<title>{{head.title}}</title>

<!-- initial-load overlay: critical inline styles so it shows before the bundle
     loads and hides the FOUC (sprite injection / style application) -->
<style>
    .app-loader{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:#f5f8fa;transition:opacity .4s ease,visibility 0s linear .4s}
    .app-loader.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
    .app-loader__spinner{width:44px;height:44px;border-radius:50%;border:3px solid #dfe7f1;border-top-color:#0081ff;animation:app-loader-spin .7s linear infinite}
    @keyframes app-loader-spin{to{transform:rotate(360deg)}}
    @media (prefers-reduced-motion:reduce){.app-loader__spinner{animation-duration:1.6s}}

    /* Critical header layout: without this the header renders as plain blocks before
       app.css applies, so the search field stretches full-width and then snaps to its
       real size (a visible jump on load, esp. under the CMS where app.css isn't always
       render-blocking). These mirror Header.scss / HeaderSearch.scss — keep in sync if
       the search width changes. */
    .header__wrapper{display:flex;justify-content:space-between;width:100%}
    .header__inner{display:flex;align-items:center}
    .filter-search{display:none}
    body[data-header-search] .filter-search{flex:0 0 auto;align-self:center;width:max(266.6666666667px,26.0416666667vw);margin-left:max(32px,3.125vw);margin-right:auto}
    @media (min-width:744px){body[data-header-search] .filter-search{display:block}}
    @media (min-width:1024px) and (max-width:1439.98px){body[data-header-search] .filter-search{width:max(355.5555555556px,34.7222222222vw);margin-left:max(42.6666666667px,4.1666666667vw)}}
    @media (max-width:743.98px){body[data-header-search] .filter-search{display:block;order:10;flex:0 0 100%;width:100%;margin-inline:0}body[data-header-search] .header__wrapper{flex-wrap:wrap}}
</style>
<script>window.addEventListener("load",function(){var l=document.querySelector("[data-app-loader]");if(l){l.classList.add("is-hidden");setTimeout(function(){l.parentNode&&l.remove()},500)}})</script>

<meta name="description" content="{{or head.description site.seoDefaults.description 'Описание сайта'}}" />

{{#each meta}}
    <meta {{{attrs this}}} />
{{/each}}

{{#each linkPreload}}
    <link {{{attrs this}}} />
{{/each}}

{{#each linkOther}}
    <link {{{attrs this}}} />
{{/each}}

{{#if page.canonical}}
    <link rel="canonical" href="{{page.canonical}}" />
{{/if}}

<meta property="og:type" content="website" />
<meta property="og:locale" content="{{or site.ogLocale 'ru_RU'}}" />
<meta property="og:site_name" content="{{or site.siteName head.title 'Vite'}}" />
<meta property="og:title" content="{{or head.title site.siteName 'Vite'}}" />
<meta property="og:description" content="{{or head.description site.seoDefaults.description 'Описание сайта'}}" />
{{#if head.ogImage}}
    <meta property="og:image" content="{{asset head.ogImage}}" />
{{/if}}

<meta name="twitter:card" content="{{or head.twitterCard 'summary_large_image'}}" />
<meta name="twitter:title" content="{{or head.title site.siteName 'Vite'}}" />
<meta name="twitter:description" content="{{or head.description site.seoDefaults.description 'Описание сайта'}}" />
{{#if head.ogImage}}
    <meta name="twitter:image" content="{{asset head.ogImage}}" />
{{/if}}
