{{!--
	«Разделы» Помощи — карточки разделов.
	props: id, title, items [{ icon (иконка спрайта: «erp-tasks», «site-home»…), title, url, countText
	(«14 статей»), text, links [{ text, url }] (до 3 статей), moreText }].
--}}
{{#if props.items.length}}
    <section class="help-categories" aria-labelledby="{{default props.id 'help-categories'}}-title">
        <h2 class="help-categories__title" id="{{default props.id 'help-categories'}}-title">{{default props.title "Разделы"}}</h2>
        <ul class="help-categories__list" role="list">
            {{#each props.items}}
                <li class="help-card">
                    <div class="help-card__head">
                        <span class="help-card__tile">
                            {{#if icon}}<svg class="help-card__icon" aria-hidden="true" focusable="false"><use href="{{@root.sprite}}#icon-{{icon}}"></use></svg>{{/if}}
                        </span>
                        <div class="help-card__titles">
                            <h3 class="help-card__title">{{title}}</h3>
                            {{#if countText}}<p class="help-card__count">{{countText}}</p>{{/if}}
                        </div>
                    </div>
                    {{#if text}}<p class="help-card__text">{{text}}</p>{{/if}}
                    {{#if links.length}}
                        <ul class="help-card__links" role="list">
                            {{#each links}}<li><a class="help-card__link" href="{{url}}">{{text}}</a></li>{{/each}}
                        </ul>
                    {{/if}}
                    {{#if url}}
                        <a class="help-card__more" href="{{url}}">{{default moreText "Все статьи раздела"}}<span class="visually-hidden"> «{{title}}»</span>{{> components/Icon/Icon name="chevron-right" class="help-card__more-icon"}}</a>
                    {{/if}}
                </li>
            {{/each}}
        </ul>
    </section>
{{/if}}
